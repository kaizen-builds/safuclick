{
  "version": 2,
  "_comment": "Hardened rules (v2), produced by the closed loop (npm run loop --promote) from Kane reports. Baseline: rules.baseline.json.",
  "domain": {
    "maxEditDistance": 2,
    "flagBrandTokens": true,
    "flagPunycode": true
  },
  "contracts": {
    "requireKnownContract": true
  },
  "approval": {
    "flagMaxUint": true,
    "maxAllowanceRatio": 10,
    "requireKnownSpender": true,
    "flagAddressPoisoning": true
  },
  "seed": {
    "patterns": [
      "seed phrase",
      "recovery phrase",
      "mnemonic",
      "private key",
      "secret words",
      "\\b(12|24)[- ]?(secret |recovery |seed |private )?words\\b",
      "re-?sync.{0,40}(wallet|words)"
    ]
  },
  "kane": {
    "flagFailedFlow": true,
    "textPatterns": [
      "unlimited",
      "seed phrase",
      "recovery[- ]phrase",
      "recovery (words|credentials)",
      "secret (recovery )?words",
      "private key",
      "does not match",
      "did not match",
      "mismatch",
      "approv",
      "spender",
      "secret words"
    ]
  }
}
